# ── App under test ──────────────────────────────────────────────────────────
# URL the pipeline points at. Change this to test your own app.
QA_BASE_URL=http://localhost:3000

# Login credentials for workflows that include a sign-in step. Leave blank to
# have the parser use whatever credentials appear in the steps file.
QA_USERNAME=
QA_PASSWORD=

# ── LLM backend ──────────────────────────────────────────────────────────────
# One of: anthropic | openai | google | ollama
LLM_BACKEND=anthropic

# Optional: pin a specific model. If unset, each backend uses a sensible default.
# QA_MODEL=claude-sonnet-4-6

# API key for the backend you chose (only the relevant one is needed).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Ollama runs locally and needs no key — just `ollama serve`.
